# URL do Postgres (Railway injeta via plugin; local: docker compose)
DATABASE_URL=postgres://user:pass@localhost:5433/worlds
# true só quando o Postgres exige SSL (Railway); local compose não precisa
DATABASE_SSL=false
# Token do editor — gere com: openssl rand -hex 32
EDITOR_TOKEN=
# Origens permitidas no CORS, separadas por vírgula (URL do jogo + dev local)
ALLOWED_ORIGINS=http://localhost:5173
# Porta HTTP (Railway injeta; local default 3001)
PORT=3001
