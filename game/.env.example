# Senha do editor de níveis (/editor). Vazio = editor liberado (dev).
# Em produção, defina um valor — o gate só esconde a UI; a segurança real
# vem do token da API na Fase 3.
VITE_EDITOR_PASSWORD=

# URL da API do editor (Fase 3) — vazio = jogo usa só o mundo bundled.
# Em dev local: http://localhost:3001 — em produção: URL do serviço api.
VITE_API_URL=
